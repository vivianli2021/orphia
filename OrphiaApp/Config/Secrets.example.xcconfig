// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// See docs/supabase-google-auth-setup.md, Part 5.
// xcconfig treats "//" as a comment, so URLs are written as https:/$()/...

SUPABASE_URL = https:/$()/YOUR-PROJECT-ID.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR-KEY

GOOGLE_IOS_CLIENT_ID = YOUR-IOS-CLIENT-ID.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.YOUR-IOS-CLIENT-ID
GOOGLE_WEB_CLIENT_ID = YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
